#!/bin/sh
set -u
case "$1" in
  start)
    rm -f /run/jack-ready /run/jack-rate /run/jack-period /run/jack-nperiods /run/jack-capture-ports /run/jack-playback-ports /run/jack-realtime /run/jack-xruns
    : > /var/log/jack.log
    fail() { printf '%s\n' "$*" >>/var/log/jack.log; /usr/bin/sc-adat-progress "JACK status: FAIL ($*)"; /usr/bin/sc-adat-console-log --tail /var/log/jack.log 'JACK failure log'; }
    /usr/bin/sc-adat-progress 'Digi9652 status: waiting'
    i=0
    while test "$i" -lt 8; do grep -q Digi9652 /proc/asound/cards 2>/dev/null && break; modprobe snd-rme9652 2>/dev/null || true; sleep 1; i=$((i + 1)); done
    if ! grep -q Digi9652 /proc/asound/cards 2>/dev/null; then fail 'not detected'; exit 0; fi
    /usr/bin/sc-adat-progress 'Digi9652 status: PASS'
    capture_channels=$(timeout 4 arecord -D hw:CARD=Digi9652,DEV=0 --dump-hw-params -f S32_LE -r 48000 -c 26 </dev/zero 2>&1 | grep -E 'CHANNELS:' | tail -1 | grep -Eo '[0-9]+' | tail -1 || true)
    playback_channels=$(timeout 4 aplay -D hw:CARD=Digi9652,DEV=0 --dump-hw-params -f S32_LE -r 48000 -c 26 </dev/zero 2>&1 | grep -E 'CHANNELS:' | tail -1 | grep -Eo '[0-9]+' | tail -1 || true)
    printf '%s\n' "${capture_channels:-0}" >/run/alsa-capture-channels; printf '%s\n' "${playback_channels:-0}" >/run/alsa-playback-channels
    if ! timeout 5 jackd -d alsa --help >/run/jack-alsa-help 2>&1 || ! grep -Eq -- '--device.*ALSA device|--rate.*Sample rate|--period.*Frames per period|--nperiods|--inchannels|--outchannels' /run/jack-alsa-help; then fail 'ALSA backend parser/help validation'; exit 0; fi
    jackd -R -P 70 -d alsa --device hw:CARD=Digi9652,DEV=0 --rate 48000 --period 128 --nperiods 2 --inchannels 26 --outchannels 26 >/var/log/jack.log 2>&1 &
    echo $! >/run/jackd.pid
    i=0
    while test "$i" -lt 15; do
      if ! kill -0 "$(cat /run/jackd.pid)" 2>/dev/null; then fail 'process exited'; exit 0; fi
      if sc-adat-jack-probe >/run/jack-ports 2>/dev/null; then
        rate=$(grep '^rate=' /run/jack-ports | cut -d= -f2); period=$(grep '^period=' /run/jack-ports | cut -d= -f2)
        nperiods=0; tr '\000' ' ' </proc/$(cat /run/jackd.pid)/cmdline 2>/dev/null | grep -Eq -- '--nperiods 2' && nperiods=2
        capture=$(grep -Ec '^PHYSICAL_CAPTURE ' /run/jack-ports || true); playback=$(grep -Ec '^PHYSICAL_PLAYBACK ' /run/jack-ports || true)
        printf '%s\n' "$rate" >/run/jack-rate; printf '%s\n' "$period" >/run/jack-period; printf '%s\n' "${nperiods:-0}" >/run/jack-nperiods; printf '%s\n' "$capture" >/run/jack-capture-ports; printf '%s\n' "$playback" >/run/jack-playback-ports
        if test "$rate" = 48000 && test "$period" = 128 && test "${nperiods:-0}" = 2 && test "$capture" = 26 && test "$playback" = 26 && ! grep -Eqi 'alsa.*(fail|error)|xrun' /var/log/jack.log; then
          if ps -eLo pid,tid,cls,rtprio,comm,args 2>/dev/null | awk '$0 ~ /jackd/ && $3 == "FF" && $4 == 70 {found=1} END{exit !found}'; then touch /run/jack-realtime /run/jack-ready; /usr/bin/sc-adat-progress 'JACK status: PASS'; exit 0; fi
        fi
      fi
      sleep 1; i=$((i + 1))
    done
    fail 'validation timeout or zero/mismatched runtime values'
    ;;
  stop) test -r /run/jackd.pid && kill "$(cat /run/jackd.pid)" 2>/dev/null || true ;;
  *) exit 2 ;;
esac
