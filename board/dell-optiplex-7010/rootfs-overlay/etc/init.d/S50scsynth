#!/bin/sh
set -u
case "$1" in
  start)
    rm -f /run/scsynth-ready /run/scsynth-input-ports /run/scsynth-output-ports
    if test ! -e /run/jack-ready; then /usr/bin/sc-adat-progress 'scsynth status: FAIL (JACK unavailable)'; exit 0; fi
    : > /var/log/scsynth.log
    timeout 20 scsynth -u 57110 -a 4096 -b 4096 -m 262144 -w 1024 -i 26 -o 26 -z 128 -H jack -R 0 >/var/log/scsynth.log 2>&1 &
    echo $! >/run/scsynth.pid
    i=0
    while test "$i" -lt 20; do
      sc-adat-jack-probe >/run/scsynth-ports 2>/run/scsynth-ports-error || true
      input_count=$(grep -Ec '^PORT (jack:in_|scsynth:in_)' /run/scsynth-ports || true); output_count=$(grep -Ec '^PORT (jack:out_|scsynth:out_)' /run/scsynth-ports || true)
      printf '%s\n' "$input_count" >/run/scsynth-input-ports; printf '%s\n' "$output_count" >/run/scsynth-output-ports
      if grep -Eqi 'server.*ready|SuperCollider 3 server ready' /var/log/scsynth.log && test "$input_count" = 26 && test "$output_count" = 26 && kill -0 "$(cat /run/scsynth.pid)" 2>/dev/null; then touch /run/scsynth-ready; /usr/bin/sc-adat-progress 'scsynth status: PASS'; exit 0; fi
      kill -0 "$(cat /run/scsynth.pid)" 2>/dev/null || break; sleep 1; i=$((i + 1))
    done
    /usr/bin/sc-adat-progress 'scsynth status: FAIL (timeout or port/readiness validation)'
    /usr/bin/sc-adat-console-log --tail /var/log/scsynth.log 'scsynth failure log'
    ;;
  stop) test -r /run/scsynth.pid && kill "$(cat /run/scsynth.pid)" 2>/dev/null || true ;;
  *) exit 2 ;;
esac
