#!/bin/sh
set -u
case "$1" in
  start) rm -f /run/dropbear-ready; if test -r /var/run/dropbear.pid && kill -0 "$(cat /var/run/dropbear.pid)" 2>/dev/null; then touch /run/dropbear-ready; /usr/bin/sc-adat-progress 'Dropbear status: PASS (password-development-mode)'; else /usr/bin/sc-adat-progress 'Dropbear status: FAIL'; fi ;;
  stop) : ;;
  *) exit 2 ;;
esac
