#!/bin/sh
set -u

case "${1:-start}" in
  start)
    mkdir -p /data /var/log /run
    rm -f /run/sc-adat-data-discovered /run/sc-adat-data-mounted
    printf '%s\n' 'data filesystem: waiting for label SC_ADAT_DATA' >/var/log/sc-adat-payload.log
    source=
    i=0
    while test "$i" -lt 15; do
      source=$(blkid -L SC_ADAT_DATA 2>/dev/null || true)
      if test -b "$source"; then
        touch /run/sc-adat-data-discovered
        printf 'data filesystem discovered: %s\n' "$source" >>/var/log/sc-adat-payload.log
        if mount -o ro,nosuid,nodev,noexec,noatime "$source" /data 2>>/var/log/sc-adat-payload.log; then
          if awk '$2 == "/data" && $4 ~ /(^|,)ro(,|$)/ {ok=1} END {exit !ok}' /proc/mounts; then
            touch /run/sc-adat-data-mounted
            printf '%s\n' 'data filesystem mounted read-only' >>/var/log/sc-adat-payload.log
          else
            printf '%s\n' 'data filesystem mount was not read-only' >>/var/log/sc-adat-payload.log
            umount /data 2>/dev/null || true
          fi
        fi
        break
      fi
      sleep 1; i=$((i + 1))
    done
    if test ! -e /run/sc-adat-data-discovered; then printf '%s\n' 'data filesystem missing; using factory payload' >>/var/log/sc-adat-payload.log; fi
    if test ! -e /run/sc-adat-data-mounted; then mkdir -p /data/sc-adat; fi
    if SC_ADAT_NO_SWITCH=1 SC_ADAT_STATE_DIR=/run/sc-adat /usr/bin/sc-adat-payload-consumer /data/sc-adat activate >>/var/log/sc-adat-payload.log 2>&1; then
      if test -r /run/sc-adat/payload-version; then printf 'payload version: %s\n' "$(cat /run/sc-adat/payload-version)" >>/var/log/sc-adat-payload.log; fi
      touch /run/sc-adat-payload-activated
    else
      printf '%s\n' 'payload activation failed; factory unavailable' >>/var/log/sc-adat-payload.log
      rm -f /run/sc-adat-payload-activated
    fi
    ;;
  stop) : ;;
  *) exit 2 ;;
esac
