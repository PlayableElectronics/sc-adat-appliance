#!/bin/sh
set -u
case "${1:-start}" in
  start)
    if test ! -e /run/scsynth-ready; then /usr/bin/sc-adat-progress 'self-test: FAIL (scsynth not ready)'; /usr/bin/sc-adat-progress 'final FAIL summary'; exit 0; fi
    failures=0; log=/var/log/sc-adat-self-test.log; : >"$log"
    check() { if "$@"; then r=PASS; else r=FAIL; failures=$((failures + 1)); fi; printf '%s %s\n' "$1" "$r" >>"$log"; }
    check test -e /run/dev-shm-ready
    check grep -q Digi9652 /proc/asound/cards
    check test -e /run/jack-ready
    check test -e /run/scsynth-ready
    printf 'cmdline: '; cat /proc/cmdline >>"$log"; cat /proc/asound/cards >>"$log" 2>/dev/null || true; ps >>"$log" 2>&1 || true
    test "$failures" -eq 0 && summary='final PASS summary' || summary="final FAIL summary ($failures failed)"
    printf '%s\n' "$summary" >>"$log"; /usr/bin/sc-adat-progress "$summary"
    ;;
  stop) : ;;
  *) exit 2 ;;
esac
