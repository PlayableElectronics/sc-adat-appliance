#!/bin/sh
set -u

log=/var/log/sc-adat-self-test.log
failures=0
mkdir -p /var/log /run

check() {
    name=$1
    shift
    if "$@"; then
        result=PASS
    else
        result=FAIL
        failures=$((failures + 1))
    fi
    printf '%-28s %s\n' "$name" "$result" >> "$log"
}

case "${1:-start}" in
  start)
    : > "$log"
    {
        date -u '+self_test=%Y-%m-%dT%H:%M:%SZ'
        uname -a
        cat /proc/cmdline
        echo '--- kernel config ---'
        gzip -cd /proc/config.gz 2>/dev/null | grep -E 'CONFIG_(PREEMPT_RT|HIGH_RES_TIMERS|HZ_1000)=' || true
        echo '--- audio card ---'
        cat /proc/asound/cards 2>/dev/null || true
        echo '--- processes ---'
        ps -eo pid,cls,rtprio,pri,ni,stat,comm,args 2>/dev/null || true
        echo '--- jack ports ---'
        jack_lsp 2>/dev/null || true
    } >> "$log" 2>&1

    check 'PREEMPT_RT kernel' sh -c 'gzip -cd /proc/config.gz 2>/dev/null | grep -qx CONFIG_PREEMPT_RT=y'
    check 'Digi9652 detected' sh -c "grep -q Digi9652 /proc/asound/cards"

    jack_pid=$(cat /run/jackd.pid 2>/dev/null || true)
    check 'JACK realtime scheduling' sh -c "test -n '$jack_pid' && test -d /proc/$jack_pid && ps -L -p '$jack_pid' -o cls=,rtprio= 2>/dev/null | awk '\$1 == \"RR\" || \$1 == \"FF\" { if (\$2 >= 70) found=1 } END { exit !found }'"

    ports=$(jack_lsp 2>/dev/null || true)
    capture_count=$(printf '%s\n' "$ports" | grep -Ec '^system:capture_[0-9]+$' || true)
    playback_count=$(printf '%s\n' "$ports" | grep -Ec '^system:playback_[0-9]+$' || true)
    sc_in_count=$(printf '%s\n' "$ports" | grep -Ec '^jack:in_[0-9]+$' || true)
    sc_out_count=$(printf '%s\n' "$ports" | grep -Ec '^jack:out_[0-9]+$' || true)
    check '26 JACK capture ports' test "$capture_count" -eq 26
    check '26 JACK playback ports' test "$playback_count" -eq 26
    check '26 scsynth input ports' test "$sc_in_count" -eq 26
    check '26 scsynth output ports' test "$sc_out_count" -eq 26

    sc_pid=$(cat /run/scsynth.pid 2>/dev/null || true)
    check 'scsynth ready' sh -c "test -n '$sc_pid' && test -d /proc/$sc_pid && grep -q '^jack:in_1$' <<EOF
$ports
EOF"

    printf 'counts: capture=%s playback=%s scsynth_in=%s scsynth_out=%s\n' \
        "$capture_count" "$playback_count" "$sc_in_count" "$sc_out_count" >> "$log"
    printf 'summary: %s (%s failed)\n' "$(test "$failures" -eq 0 && echo PASS || echo FAIL)" "$failures" >> "$log"
    summary=$(tail -n 1 "$log")
    printf '%s\n' "$summary" > /dev/tty0 2>/dev/null || true
    printf '%s\n' "$summary" > /dev/ttyS0 2>/dev/null || true
    test "$failures" -eq 0
    ;;
  stop) ;;
  *) echo "Usage: $0 {start|stop}" >&2; exit 2 ;;
esac
