#!/bin/sh
set -u

finalize() {
  result=$1
  printf 'PAYLOAD-QEMU FINAL %s\n' "$result"
  sync
  poweroff -f >/dev/null 2>&1 || reboot -f >/dev/null 2>&1 || true
}
fail() { echo "PAYLOAD-QEMU FAIL: $*"; finalize FAIL; exit 1; }
pass() { echo "PAYLOAD-QEMU PASS: $*"; }
for c in stat find grep sed sort readlink sha256sum dirname blkid mount awk mv ln mkdir cat cp rm touch sleep umount timeout sync poweroff reboot; do command -v "$c" >/dev/null 2>&1 || fail "missing target command: $c"; done
test "$(stat -c '%u:%a' /usr/share/sc-adat/factory)" = 0:555 || fail stat
test -z "$(find /usr/share/sc-adat/factory -type d ! -perm 555 -print)" || fail find-perm
(cd /usr/share/sc-adat/factory && sha256sum -c manifest.sha256 >/dev/null) || fail sha256sum
mkdir -p /run/payload-qemu; mount -t tmpfs -o nosuid,nodev,noexec,noatime tmpfs /run/payload-qemu || fail mount
awk '$2 == "/run/payload-qemu" && $4 ~ /(^|,)rw(,|$)/ {ok=1} END {exit !ok}' /proc/mounts || fail awk
umount /run/payload-qemu
cp /usr/libexec/sc-adat-qemu-payload-loader /run/payload-test-loader
factory_version=$(cat /usr/share/sc-adat/factory/VERSION) || fail factory-version
make_valid() { cp -a /usr/share/sc-adat/factory "$1"; }
run_case() {
  name=$1; root=$2; expected_output=$3; expected_version=$4
  output=$(SC_ADAT_OSC_LOADER=/run/payload-test-loader SC_ADAT_FACTORY=/usr/share/sc-adat/factory SC_ADAT_OWNER=0 SC_ADAT_STATE_DIR=/run/payload-state-$name /usr/bin/sc-adat-payload-consumer "$root" activate 2>&1) || fail "$name: $output"
  printf '%s\n' "$output" | grep -Fxq "$expected_output" || fail "$name output: $output"
  test "$(cat /run/payload-state-$name/payload-version)" = "$expected_version" || fail "$name state version"
  pass "$name: $output (state=$expected_version)"
}

rm -rf /run/payload-data; mkdir -p /run/payload-data/releases
make_valid /run/payload-data/releases/current-valid
current_version=$(cat /run/payload-data/releases/current-valid/VERSION) || fail current-version
ln -s releases/current-valid /run/payload-data/current
run_case current-valid /run/payload-data "activated $current_version" "$current_version"

rm -rf /run/payload-data; mkdir -p /run/payload-data/releases
make_valid /run/payload-data/releases/previous-valid
previous_version=$(cat /run/payload-data/releases/previous-valid/VERSION) || fail previous-version
make_valid /run/payload-data/releases/current-invalid
rm -f /run/payload-data/releases/current-invalid/manifest.sha256
ln -s releases/current-invalid /run/payload-data/current
ln -s releases/previous-valid /run/payload-data/previous
run_case current-previous /run/payload-data 'activated previous' "$previous_version"

rm -rf /run/payload-data; mkdir -p /run/payload-data/releases
make_valid /run/payload-data/releases/current-invalid
make_valid /run/payload-data/releases/previous-invalid
rm -f /run/payload-data/releases/current-invalid/manifest.sha256 /run/payload-data/releases/previous-invalid/manifest.sha256
ln -s releases/current-invalid /run/payload-data/current
ln -s releases/previous-invalid /run/payload-data/previous
run_case factory-fallback /run/payload-data 'activated factory' "$factory_version"

rm -rf /run/payload-data
run_case missing-data /run/payload-data 'activated factory' "$factory_version"
finalize PASS
