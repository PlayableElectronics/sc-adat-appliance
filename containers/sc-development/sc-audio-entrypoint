#!/bin/sh
set -eu

if [ "${JACK_REALTIME:-0}" = 1 ]; then
  jack_mode='-R -P70'
else
  # JACK otherwise attempts mlockall(2), which is denied by this host even
  # for root. The realtime path deliberately omits -m once the host permits
  # memory locking.
  jack_mode='-r -m'
fi

jackd $jack_mode -dalsa -d'hw:CARD=Digi9652,DEV=0' \
  -r48000 -p128 -n2 -i26 -o26 > /var/log/jack.log 2>&1 &
jack_pid=$!
printf '%s\n' "$jack_pid" > /run/jackd.pid
sc_pid=0

cleanup() {
  if [ "$sc_pid" -gt 0 ]; then kill "$sc_pid" 2>/dev/null || true; fi
  if [ "$jack_pid" -gt 0 ]; then kill "$jack_pid" 2>/dev/null || true; fi
  if [ "$sc_pid" -gt 0 ]; then wait "$sc_pid" 2>/dev/null || true; fi
  if [ "$jack_pid" -gt 0 ]; then wait "$jack_pid" 2>/dev/null || true; fi
  rm -f /run/jackd.pid /run/scsynth.pid
}
trap cleanup INT TERM EXIT

for _ in $(seq 1 100); do
  if jack_lsp >/dev/null 2>&1; then
    break
  fi
  if ! kill -0 "$jack_pid" 2>/dev/null; then
    echo 'JACK exited before becoming available' >&2
    cat /var/log/jack.log >&2 || true
    exit 1
  fi
  sleep 0.1
done

if ! jack_lsp >/dev/null 2>&1; then
  echo 'JACK did not become available' >&2
  cat /var/log/jack.log >&2 || true
  exit 1
fi

# JACK owns the physical 26-channel device. scsynth uses JACK ports and has
# headroom for a future 24-channel mixer; no synth or test signal is started.
mkdir -p /root/.local/share/SuperCollider/synthdefs
scsynth -u 57110 -a 4096 -b 4096 -m 262144 -w 1024 \
  -i 26 -o 26 -z 128 -H jack -R 0 > /var/log/scsynth.log 2>&1 &
sc_pid=$!
printf '%s\n' "$sc_pid" > /run/scsynth.pid

wait "$sc_pid"
