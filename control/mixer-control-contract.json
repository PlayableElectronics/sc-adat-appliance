    {"key_template": "polarityN", "scope": "channel", "label": "Polarity", "value_type": "enum", "readable": true, "writable": true, "live_changeable": true, "modes": ["stereo", "quad"], "unit": "polarity", "display": "NORMAL/INVERTED", "range": {"values": [-1, 1]}, "increments": null, "default_source": "channel.N.polarity", "confirmation": "always", "dsp_mapping": {"node": "router", "control_template": "polarityN"}, "presentation_order": 30, "shortcut": "p"},
    {"key_template": "hpfN", "scope": "channel", "label": "HPF", "value_type": "boolean", "readable": true, "writable": true, "live_changeable": true, "modes": ["stereo", "quad"], "unit": "boolean", "display": "ON/OFF", "range": {"values": [0, 1]}, "increments": null, "default_source": "channel.N.hpf", "confirmation": "none", "dsp_mapping": {"node": "router", "control_template": "hpfN"}, "presentation_order": 40, "shortcut": "h"},
    {"key_template": "hpfHzN", "scope": "channel", "label": "HPF cutoff", "value_type": "frequency", "readable": true, "writable": true, "live_changeable": true, "modes": ["stereo", "quad"], "unit": "Hz", "display": "Hz", "range": {"min": 20, "max": 20000, "unit": "Hz"}, "enumerated_steps": [20, 30, 50, 80, 120, 200, 350, 500, 800, 1200, 2000, 3500, 5000, 8000, 12000, 16000, 20000], "increments": null, "default_source": "channel.N.hpf_hz", "confirmation": "none", "dsp_mapping": {"node": "router", "control_template": "hpfHzN"}, "presentation_order": 50, "shortcut": null},
    {"key_template": "groupLevelN", "scope": "group", "label": "Level", "value_type": "amplitude", "readable": true, "writable": true, "live_changeable": true, "modes": ["stereo", "quad"], "unit": "dB", "display": "dB", "range": {"min": 0.0, "max": 2.0, "unit": "amplitude"}, "increments": {"fine": 0.5, "coarse": 3.0, "unit": "dB"}, "default_source": "group.<name>.level_db", "confirmation": "none", "dsp_mapping": {"node": "group", "control": "gain"}, "presentation_order": 10, "shortcut": null},
    {"key_template": "groupNPosX", "scope": "group", "label": "Stereo X / pan", "value_type": "normalized", "readable": true, "writable": true, "live_changeable": true, "modes": ["stereo", "quad"], "unit": "normalized", "display": "0.00..1.00", "range": {"source": "group_limits.x"}, "increments": {"fine": 0.05, "coarse": 0.2, "unit": "normalized"}, "default_source": "group.<name>.pos_x", "confirmation": "none", "dsp_mapping": {"node": "group", "control": "x"}, "presentation_order": 20, "shortcut": null},
