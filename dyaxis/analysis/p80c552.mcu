; Philips 8XC552/562 SFR and vector names.
; Source: Philips Semiconductors, 8XC552/562 overview, 1996-08-06,
; Table 1 and Table 9. This is deliberately not the generic 8051 T2 map.

P0 DATA 80h
SP DATA 81h
DPL DATA 82h
DPH DATA 83h
PCON DATA 87h
ACC DATA E0h
B DATA F0h
TCON DATA 88h
TMOD DATA 89h
TL0 DATA 8Ah
TL1 DATA 8Bh
TH0 DATA 8Ch
TH1 DATA 8Dh
P1 DATA 90h
S0CON DATA 98h
S0BUF DATA 99h
P2 DATA A0h
IEN0 DATA A8h
P3 DATA B0h
IP0 DATA B8h
P4 DATA C0h
TM2IR DATA C8h
CMH2 DATA CBh
CMH1 DATA CAh
CMH0 DATA C9h
CTH0 DATA CCh
CTH1 DATA CDh
CTH2 DATA CEh
CTH3 DATA CFh
S1CON DATA D8h
S1STA DATA D9h
SIDAT DATA DAh
S1ADR DATA DBh
PSW DATA D0h
ADCON DATA C5h
P5 DATA C4h
TM2CON DATA EAh
IEN1 DATA E8h
IP1 DATA F8h
T3 DATA FFh
RTE DATA EFh
CML0 DATA A9h
PWMP DATA FEh
PWM1 DATA FDh
PWM0 DATA FCh

RESET CODE 0000h
EXT0 CODE 0003h
TIMER0 CODE 000Bh
EXT1 CODE 0013h
TIMER1 CODE 001Bh
SIO0_UART CODE 0023h
