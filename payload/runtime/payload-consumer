#!/bin/sh
set -eu
ROOT=${1:-/data/sc-adat}; ACTION=${2:-verify}; FACTORY=${SC_ADAT_FACTORY:-/usr/share/sc-adat/factory}; LOADER=${SC_ADAT_OSC_LOADER:-/usr/bin/sc-adat-osc-loader}; STATE_DIR=${SC_ADAT_STATE_DIR:-/run/sc-adat}; OWNER=${SC_ADAT_OWNER:-0}
die() { echo "payload: $*" >&2; exit 1; }
release_path() { target=$1; case "$target" in releases/*/*|releases/|*..*|*/*/*) return 1;; releases/[A-Za-z0-9._-]*) printf '%s/%s\n' "$ROOT" "$target";; *) return 1;; esac; }
valid() { d=$1; test -d "$d" || return 1; case "$d" in "$ROOT/releases/"*|"$FACTORY") ;; *) return 1;; esac; test -f "$d/VERSION" -a -f "$d/manifest.sha256" -a -f "$d/metadata.json" || return 1; mode=$(stat -c '%u:%a' "$d" 2>/dev/null || echo bad); test "$mode" = "$OWNER:555" -o "$mode" = "$OWNER:755" || return 1; find "$d" -exec stat -c '%u' {} \; | grep -v "^$OWNER$" >/dev/null 2>&1 && return 1; find "$d" -type l -o ! -type f -a ! -type d | grep . >/dev/null 2>&1 && return 1; find "$d" -type d ! -perm 555 | grep . >/dev/null 2>&1 && return 1; find "$d" -type f ! -path "$d/scripts/payload-consumer" ! -perm 444 | grep . >/dev/null 2>&1 && return 1; test "$(stat -c '%a' "$d/scripts/payload-consumer" 2>/dev/null)" = 555 || return 1; grep -Fxq 'protocol_version=1' "$d/config/payload.conf" || return 1; grep -Fq '"protocol_version":1' "$d/metadata.json" || return 1; grep -Fq 'sc_adat_tone24' "$d/metadata.json" && grep -Fq 'sc_adat_scan' "$d/metadata.json" || return 1; expected='VERSION\nmetadata.json\nconfig/payload.conf\nscripts/payload-consumer\nsynthdefs/sc_adat_scan.scsyndef\nsynthdefs/sc_adat_tone24.scsyndef'; actual=$(sed 's/^[^ ]*  //' "$d/manifest.sha256" | sort); test "$actual" = "$(printf '%b\n' "$expected" | sort)" || return 1; (cd "$d" && sha256sum -c manifest.sha256 >/dev/null) || return 1; grep -aFq sc_adat_tone24 "$d/synthdefs/sc_adat_tone24.scsyndef" || return 1; grep -aFq sc_adat_scan "$d/synthdefs/sc_adat_scan.scsyndef" || return 1; }
current_valid() { test -L "$ROOT/current" || return 1; d=$(release_path "$(readlink "$ROOT/current")") || return 1; valid "$d"; }
switch() { new=$1; old=${2:-}; ln -s "$new" "$ROOT/.current.$$"; mv -Tf "$ROOT/.current.$$" "$ROOT/current"; test -n "$old" && { ln -s "$old" "$ROOT/.previous.$$"; mv -Tf "$ROOT/.previous.$$" "$ROOT/previous"; } || true; }
activate_release() { d=$1; valid "$d" || return 1; out=$($LOADER load "$d/synthdefs/sc_adat_tone24.scsyndef" "$d/synthdefs/sc_adat_scan.scsyndef" 2>&1) || return 1; echo "$out" | grep -Fxq /done || { echo "$out" >&2; return 1; }; out=$($LOADER sync 2>&1) || return 1; echo "$out" | grep -Fxq /synced || { echo "$out" >&2; return 1; }; out=$($LOADER validate 2>&1) || return 1; echo "$out" | grep -Fxq VALID || return 1; $LOADER activate >/dev/null 2>&1 || return 1; mkdir -p "$STATE_DIR"; printf '%s\n' "$(cat "$d/VERSION")" >"$STATE_DIR/payload-version"; }
case "$ACTION" in
verify) current_valid || die 'current is missing, unsafe or checksum-invalid'; echo "verified $(cat "$ROOT/current/VERSION")";;
select) if current_valid; then echo "current $(cat "$ROOT/current/VERSION")"; elif test -L "$ROOT/previous" && d=$(release_path "$(readlink "$ROOT/previous")") && valid "$d"; then old=$(readlink "$ROOT/current" 2>/dev/null || true); switch "$(readlink "$ROOT/previous")" "$old"; echo 'selected previous'; elif valid "$FACTORY"; then echo 'selected factory'; else die 'all payloads failed'; fi;;
rollback) test -L "$ROOT/previous" || die 'no previous payload'; d=$(release_path "$(readlink "$ROOT/previous")") || die 'previous path is unsafe'; valid "$d" || die 'previous payload is invalid'; old=$(readlink "$ROOT/current" 2>/dev/null || true); switch "$(readlink "$ROOT/previous")" "$old"; echo "rolled back to $(cat "$ROOT/current/VERSION")";;
status) if current_valid; then echo "current $(cat "$ROOT/current/VERSION")"; else echo 'invalid/inactive'; exit 1; fi;;
activate) if current_valid && d=$(release_path "$(readlink "$ROOT/current")") && activate_release "$d"; then echo "activated $(cat "$ROOT/current/VERSION")"; elif test -L "$ROOT/previous" && d=$(release_path "$(readlink "$ROOT/previous")") && valid "$d" && activate_release "$d"; then test "${SC_ADAT_NO_SWITCH:-0}" = 1 || { old=$(readlink "$ROOT/current" 2>/dev/null || true); switch "$(readlink "$ROOT/previous")" "$old"; }; echo 'activated previous'; elif valid "$FACTORY" && activate_release "$FACTORY"; then echo 'activated factory'; else die 'activation failed for current, previous and factory'; fi;;
*) echo "Usage: $0 <data-root> {verify|select|status|rollback|activate}" >&2; exit 2;; esac
