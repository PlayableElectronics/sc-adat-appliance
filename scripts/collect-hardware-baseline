#!/bin/sh
set -eu

section() {
    printf '\n## %s\n' "$1"
}

run_if_present() {
    command -v "$1" >/dev/null 2>&1 || {
        printf '%s is not installed\n' "$1"
        return 0
    }
    command "$@" 2>&1 || true
}

section "Timestamp"
date -u '+%Y-%m-%dT%H:%M:%SZ'

section "Kernel"
uname -a
test -r /sys/kernel/realtime && printf 'realtime=%s\n' "$(cat /sys/kernel/realtime)"

section "CPU"
run_if_present lscpu

section "PCI"
run_if_present lspci -nnk

section "ALSA cards"
test -r /proc/asound/cards && cat /proc/asound/cards || true

section "ALSA playback devices"
run_if_present aplay -l

section "Loaded RME modules"
run_if_present lsmod | sed -n '/rme9652\|snd/p'

section "Interrupts"
test -r /proc/interrupts && sed -n '/rme\|snd\|eth\|enp\|eno/p' /proc/interrupts || true

section "Block devices"
run_if_present lsblk -o NAME,PATH,TYPE,SIZE,FSTYPE,FSVER,MOUNTPOINTS,UUID

section "Root mount"
run_if_present findmnt /

section "Firmware boot mode"
if test -d /sys/firmware/efi; then
    printf 'UEFI\n'
else
    printf 'legacy BIOS\n'
fi

section "Network interfaces"
run_if_present ip -brief link

section "Kernel command line"
cat /proc/cmdline

section "CPU governors"
for governor in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    test -r "$governor" || continue
    printf '%s: %s\n' "$governor" "$(cat "$governor")"
done
