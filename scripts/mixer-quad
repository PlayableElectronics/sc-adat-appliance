#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
COMPOSE="${COMPOSE:-docker compose -f $ROOT/containers/sc-development/compose.yaml}"
case "${1:-}" in
  start)
    exec 9>/tmp/sc-adat-mixer-start.lock
    flock -x 9
    if test -n "$(sh -c "$COMPOSE ps --status running -q sc-mixer" 2>/dev/null)"; then
      echo 'quad mixer refused: stereo mixer is running; stop it first' >&2; exit 1
    fi
    "$ROOT/scripts/audio-clock" apply
    sh -c "$COMPOSE up -d --force-recreate sc-audio sc-quad-mixer"
    ready=0
    for retry in $(seq 1 100); do
      if sh -c "$COMPOSE exec -T sc-quad-mixer python3 /workspace/mixer/mixerctl.py meters --listen 57120" >/dev/null 2>&1; then ready=1; break; fi
      sleep 0.1
    done
    test "$ready" -eq 1 || { echo 'quad mixer did not become ready' >&2; exit 1; }
    ;;
  stop) sh -c "$COMPOSE stop sc-quad-mixer sc-audio" ;;
  status) sh -c "$COMPOSE ps sc-audio sc-quad-mixer" ;;
  test) exec "$ROOT/scripts/test-mixer-quad" ;;
  *) echo 'Usage: mixer-quad {start|stop|status|test}' >&2; exit 2 ;;
esac
