#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); OUT=${SC_ADAT_PAYLOAD_OUT:-$ROOT/.local/payload-build}; action=${1:-}; shift || true
test "${1:-}" = --data-root && test -n "${2:-}" && test "$#" -eq 2 || { echo 'expected --data-root PATH' >&2; exit 2; }; DATA=$2
case "$action" in
promote) test -f "$OUT/.tests-passed" || { echo 'payload tests have not passed' >&2; exit 1; }; version=$(cat "$OUT/VERSION"); dest="$DATA/releases/$version"; test ! -e "$dest" || { echo 'release is immutable' >&2; exit 1; }; mkdir -p "$DATA/releases"; tmp="$DATA/releases/.incoming.$$"; rm -rf "$tmp"; mkdir -p "$tmp"; cp -a "$OUT/synthdefs" "$OUT/config" "$OUT/scripts" "$OUT/VERSION" "$OUT/manifest.sha256" "$OUT/metadata.json" "$tmp/"; (cd "$tmp" && sha256sum -c manifest.sha256 >/dev/null); chmod -R a-w "$tmp"; mv "$tmp" "$dest"; old=$(readlink "$DATA/current" 2>/dev/null || true); test -z "$old" || { ln -s "$old" "$DATA/.previous.$$"; mv -Tf "$DATA/.previous.$$" "$DATA/previous"; }; ln -s "releases/$version" "$DATA/.current.$$"; mv -Tf "$DATA/.current.$$" "$DATA/current"; echo "promoted $version";;
verify|status|rollback) exec "$ROOT/payload/runtime/payload-consumer" "$DATA" "$action";;
*) echo 'Usage: payload-promote {promote|verify|status|rollback} --data-root PATH' >&2; exit 2;; esac
