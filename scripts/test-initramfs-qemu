#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
RELEASE=${1:-candidate-1}
ART="$ROOT/artifacts/sc-adat-$RELEASE"
if ! command -v qemu-system-x86_64 >/dev/null 2>&1; then
  echo "SKIP QEMU: qemu-system-x86_64 is not installed; structural checks ran in validate-native-candidate"
  exit 0
fi
set +e
timeout 35 qemu-system-x86_64 -accel tcg -m 512 -no-reboot -display none -kernel "$ART/kernel" -initrd "$ART/initramfs" -append 'console=tty0 console=ttyS0,115200n8 rdinit=/sbin/init' -nic none -device qemu-xhci,id=xhci -device usb-kbd,bus=xhci.0 -serial stdio >"$ART/qemu-boot.log" 2>&1
status=$?
set -e
grep -q 'init started' "$ART/qemu-boot.log"
grep -q 'hardware discovery' "$ART/qemu-boot.log"
grep -q 'AF_PACKET socket: PASS' "$ART/qemu-boot.log"
grep -q 'SysV semaphore creation: PASS' "$ART/qemu-boot.log"
grep -q '/dev/shm status: PASS' "$ART/qemu-boot.log"
awk '/\/dev\/shm status: PASS/{shm=NR} /starting \/etc\/init.d\/S40jack/{jack=NR} END{exit !(shm && jack && shm < jack)}' "$ART/qemu-boot.log"
grep -q 'loopback lo: UP' "$ART/qemu-boot.log"
grep -q 'finished /etc/init.d/S35network' "$ART/qemu-boot.log"
grep -q 'final FAIL summary' "$ART/qemu-boot.log"
grep -q 'SC-ADAT BOOT REPORT' "$ART/qemu-boot.log"
grep -Eq 'kernel PREEMPT_RT:[[:space:]]+PASS' "$ART/qemu-boot.log"
grep -Eq 'AF_PACKET:[[:space:]]+PASS' "$ART/qemu-boot.log"
grep -Eq 'SysV IPC:[[:space:]]+PASS' "$ART/qemu-boot.log"
grep -Eq 'Dropbear:[[:space:]]+PASS password-development-mode' "$ART/qemu-boot.log"
grep -Eq 'FINAL RESULT: FAIL \([0-9]+ failed\)' "$ART/qemu-boot.log"
! grep -q 'not found' "$ART/qemu-boot.log"
grep -Eq 'xhci|EHCI|USB' "$ART/qemu-boot.log"
echo "PASS QEMU userspace/console/bounded-no-network boot (exit=$status): $ART/qemu-boot.log"
