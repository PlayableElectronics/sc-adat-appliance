#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
RELEASE=${1:-candidate-1}
ART="$ROOT/artifacts/sc-adat-$RELEASE"
if ! command -v qemu-system-x86_64 >/dev/null 2>&1; then
  echo "SKIP QEMU: qemu-system-x86_64 is not installed; structural checks ran in validate-native-candidate"
  exit 0
fi
set +e
timeout 35 qemu-system-x86_64 -accel tcg -m 512 -no-reboot -display none -kernel "$ART/kernel" -initrd "$ART/initramfs" -append 'console=tty0 console=ttyS0,115200n8 rdinit=/sbin/init' -nic none -device qemu-xhci,id=xhci -device usb-kbd,bus=xhci.0 -serial stdio >"$ART/qemu-boot.log" 2>&1
status=$?
set -e
grep -q 'init started' "$ART/qemu-boot.log"
grep -q 'hardware discovery' "$ART/qemu-boot.log"
grep -q 'AF_PACKET socket: PASS' "$ART/qemu-boot.log"
grep -q 'SysV semaphore creation: PASS' "$ART/qemu-boot.log"
grep -q '/dev/shm status: PASS' "$ART/qemu-boot.log"
awk '/\/dev\/shm status: PASS/{shm=NR} /starting \/etc\/init.d\/S40jack/{jack=NR} END{exit !(shm && jack && shm < jack)}' "$ART/qemu-boot.log"
grep -q 'loopback lo: UP' "$ART/qemu-boot.log"
grep -q 'finished /etc/init.d/S35network' "$ART/qemu-boot.log"
grep -q 'starting /etc/init.d/S55data-payload' "$ART/qemu-boot.log"
grep -Eq 'Dropbear status: PASS \(password-development-mode\)' "$ART/qemu-boot.log"
! grep -q 'not found' "$ART/qemu-boot.log"
grep -Eq 'xhci|EHCI|USB' "$ART/qemu-boot.log"
echo "PASS QEMU userspace/console/bounded-no-network boot (exit=$status): $ART/qemu-boot.log"

set +e
timeout 35 qemu-system-x86_64 -accel tcg -m 512 -no-reboot -display none -kernel "$ART/kernel" -initrd "$ART/initramfs" -append 'console=tty0 console=ttyS0,115200n8 qemu-payload-test' -nic none -serial stdio >"$ART/qemu-payload.log" 2>&1
payload_status=$?
set -e
# Inspect the log regardless of QEMU's status, then require clean poweroff.
test "$payload_status" -eq 0
tr -d '\r' <"$ART/qemu-payload.log" >"$ART/qemu-payload.normalized.log"
test "$(grep -cE '^PAYLOAD-QEMU FINAL (PASS|FAIL)$' "$ART/qemu-payload.normalized.log")" -eq 1
grep -qx 'PAYLOAD-QEMU FINAL PASS' "$ART/qemu-payload.normalized.log"
! grep -qE 'PAYLOAD-QEMU FINAL FAIL|Kernel panic|emergency shell|not found|missing target command|PAYLOAD-QEMU FAIL' "$ART/qemu-payload.normalized.log"
grep -q 'PAYLOAD-QEMU PASS: current-valid:' "$ART/qemu-payload.normalized.log"
grep -q 'PAYLOAD-QEMU PASS: current-previous:' "$ART/qemu-payload.normalized.log"
grep -q 'PAYLOAD-QEMU PASS: factory-fallback:' "$ART/qemu-payload.normalized.log"
grep -q 'PAYLOAD-QEMU PASS: missing-data:' "$ART/qemu-payload.normalized.log"
echo "PASS QEMU target-runtime payload matrix (exit=$payload_status): $ART/qemu-payload.log"
