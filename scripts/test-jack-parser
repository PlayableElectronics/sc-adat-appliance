#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
JACK="$ROOT/board/dell-optiplex-7010/rootfs-overlay/etc/init.d/S40jack"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# Regression fixtures model jackd's valid help output with a non-zero status.
cat >"$tmp/jackd" <<'EOF'
#!/bin/sh
if test "${1:-}" = -d && test "${2:-}" = alsa && test "${3:-}" = --help; then
  printf '%s\n' '  --device DEVICE' '  --rate RATE' '  --period FRAMES' '  --nperiods N' '  --inchannels N' '  --outchannels N'
  exit 7
fi
printf '%s\n' 'runtime launch attempted' >"$TMPDIR/jack-launch-attempted"
exit 0
EOF
chmod +x "$tmp/jackd"
TMPDIR="$tmp" PATH="$tmp:$PATH" sh -c '
  help=$(jackd -d alsa --help 2>&1 || true)
  for option in --device --rate --period --nperiods --inchannels --outchannels; do
    printf "%s\n" "$help" | grep -F -- "$option" >/dev/null
  done
  jackd -R -P 70 -d alsa --device hw:CARD=Digi9652,DEV=0 --rate 48000 --period 128 --nperiods 2 --inchannels 26 --outchannels 26
  test -s "$TMPDIR/jack-launch-attempted"
'

# The production script must preserve help output, match -- safely, and launch
# the exact runtime command even when help is malformed or absent.
grep -Fq 'timeout 5 jackd -d alsa --help >/run/jack-alsa-help 2>&1 || true' "$JACK"
grep -Fq 'grep -F -- "$option" /run/jack-alsa-help' "$JACK"
grep -Fq 'jackd -R -P 70 -d alsa --device hw:CARD=Digi9652,DEV=0 --rate 48000 --period 128 --nperiods 2 --inchannels 26 --outchannels 26' "$JACK"
grep -Fq "jack_command='jackd -R -P 70" "$JACK"

echo 'PASS JACK help non-zero, safe long-option matching, and launch-attempt regressions'
