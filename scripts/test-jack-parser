#!/bin/sh
set -eu
if ! command -v jackd >/dev/null 2>&1; then echo 'SKIP JACK parser: host jackd unavailable'; exit 0; fi
test "$(jackd --version 2>&1 | grep -c '1\.9\.22')" -ge 1
help=$(jackd -d alsa --help 2>&1 || true)
for option in --device --rate --period --nperiods --inchannels --outchannels; do
  printf '%s\n' "$help" | grep -q -- "$option"
done
command='jackd -R -P 70 -d alsa --device hw:CARD=Digi9652,DEV=0 --rate 48000 --period 128 --nperiods 2 --inchannels 26 --outchannels 26'
printf '%s\n' "$command" | grep -q -- '--rate 48000 --period 128 --nperiods 2 --inchannels 26 --outchannels 26'
! printf '%s\n' "$command" | grep -Eq -- '--(rate|period|nperiods|inchannels|outchannels) 0'
echo 'PASS JACK 1.9.22 ALSA long-option parser and non-zero fixture'
