#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
OUT=${SC_ADAT_PAYLOAD_OUT:-$ROOT/.local/payload-build}
COMPOSE="${COMPOSE:-docker compose -f $ROOT/containers/sc-development/compose.yaml}"
IMAGE="${MIXER_TEST_IMAGE:-sc-adat-sc-development:debian13}"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
sh -n "$ROOT/scripts/mixer" "$ROOT/scripts/payload-build"
python3 -m py_compile "$ROOT/mixer/mixerctl.py"
"$ROOT/mixer/mixerctl.py" validate "$ROOT/payload/config/mixer.conf"
sed 's/channel.16.output=16/channel.16.output=24/' "$ROOT/payload/config/mixer.conf" >"$tmp/bad.conf"
if "$ROOT/mixer/mixerctl.py" validate "$tmp/bad.conf" >/dev/null 2>&1; then echo 'accepted physical channel above 16' >&2; exit 1; fi
sed 's/master.level_db=0/master.level_db=nan/' "$ROOT/payload/config/mixer.conf" >"$tmp/nan.conf"
if "$ROOT/mixer/mixerctl.py" validate "$tmp/nan.conf" >/dev/null 2>&1; then echo 'accepted non-finite config' >&2; exit 1; fi
test "$(grep -Ec '^channel\.[0-9]+\.(input|output)=' "$ROOT/payload/config/mixer.conf")" -eq 32
! grep -E '^channel\.[0-9]+\.(input|output)=([17-9]|1[7-9]|2[0-4])$' "$ROOT/payload/config/mixer.conf" >/dev/null
grep -q 'In.ar(26, 16)' "$ROOT/supercollider/synthdefs/sc-adat-mixer.scd"
grep -q 'SynthDef(\\sc_adat_router' "$ROOT/supercollider/synthdefs/sc-adat-mixer.scd"
grep -q 'SynthDef(\\sc_adat_group' "$ROOT/supercollider/synthdefs/sc-adat-mixer.scd"
grep -q 'SynthDef(\\sc_adat_quad_master' "$ROOT/supercollider/synthdefs/sc-adat-mixer.scd"
! grep -q 'In.ar(0, 16)' "$ROOT/supercollider/synthdefs/sc-adat-mixer.scd"
! grep -q 'Out.ar(26, outputs)' "$ROOT/supercollider/synthdefs/sc-adat-mixer.scd"
"$ROOT/scripts/payload-build" >/dev/null
for def in sc_adat_router sc_adat_group sc_adat_quad_master; do test -s "$OUT/synthdefs/$def.scsyndef"; grep -aFq "$def" "$OUT/synthdefs/$def.scsyndef"; done
docker run --rm --network host --ipc private --entrypoint sh -v "$ROOT/.local/payload-build:/payload-out:ro" -v "$ROOT/payload:/workspace/payload:ro" -v "$ROOT/mixer:/workspace/mixer:ro" "$IMAGE" -c 'set -eu; jackd -d dummy -r 48000 -p 128 >/tmp/mixer-jack.log 2>&1 & j=$!; scsynth -u 57118 -a 4096 -w 1024 -i 26 -o 26 -z 128 -H jack >/tmp/mixer-sc.log 2>&1 & s=$!; trap "kill $s $j 2>/dev/null || true" EXIT; sleep 2; SC_ADAT_OSC_PORT=57118 /usr/bin/sc-adat-osc-loader load /payload-out/synthdefs/sc_adat_router.scsyndef /payload-out/synthdefs/sc_adat_group.scsyndef /payload-out/synthdefs/sc_adat_quad_master.scsyndef /payload-out/synthdefs/sc_adat_scan.scsyndef; SC_ADAT_OSC_PORT=57118 /usr/bin/sc-adat-osc-loader sync; python3 -u /workspace/mixer/mixerctl.py apply /workspace/payload/config/mixer.conf --port 57118; python3 -u /workspace/mixer/test_mixer.py; python3 -u /workspace/mixer/test_quad.py; ! grep -iE "xrun|underrun|overrun" /tmp/mixer-jack.log'
echo 'PASS mixer syntax, eight-group reusable-node graph, deterministic config, 16-channel mapping, SynthDef compilation, dummy-JACK load/sync, neutral apply'
